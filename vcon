#!/usr/bin/env bash

# vcon - Serial console of a libvirt VM, with its name on the terminal tab title.
#
# Konsole switches to the "remote tab title format" when it detects SSH (via a
# hardcoded SSHProcessInfo class), but has no equivalent for virsh -- the tab just
# stays "~ : virsh". This fills the title in and restores it on exit.
#
# It also lists what you can connect to, running or not, and starts a stopped one
# for you.
#
# Usage:  vcon [vm-name]        with no argument, shows a menu

set -uo pipefail

# Real path of this script, with every symbolic link resolved. It matters when it
# is called through a link in a "bin" folder: without resolving the link, the
# configuration would be looked for beside the link instead of beside the script.
VCON_PATH="$(readlink -f "$0" 2> /dev/null || echo "$0")"
VCON_DIR="$(cd "$(dirname "$VCON_PATH")" && pwd)"
CONFIG_FILE="$VCON_DIR/configs/config.bash"
CONFIG_MODEL="$VCON_DIR/configs/config_model.bash"

# The configuration is optional: the defaults below are what a local libvirt
# wants, and that is the common case. Copy the model only when yours differs.
# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

CONF="${LIBVIRT_URI:-qemu:///system}"
START_TIMEOUT="${START_TIMEOUT:-90}"
IP_TIMEOUT="${IP_TIMEOUT:-60}"
SSH_USER="${SSH_USER:-}"
SSH_PORT="${SSH_PORT:-}"
[ -n "${SSH_OPTS+x}" ] || SSH_OPTS=()
declare -A SSH_USERS 2> /dev/null || true

# Credentials are libvirt's business, not this script's. Pointing at its auth file
# is all that is needed; inventing a way to carry a password around here would be
# both redundant and worse.
[ -n "${LIBVIRT_AUTH_FILE:-}" ] && export LIBVIRT_AUTH_FILE

kon() {
    : 'Talk to the Konsole of this terminal through D-Bus.

    Stays quiet and gives up when there is no Konsole around, so that the script
    keeps working on any other terminal.

    Args:
        ARGUMENTS (str): Method and arguments to hand to the Konsole session.

    Returns:
        1 when there is no Konsole to talk to.'

    [[ -n ${KONSOLE_DBUS_SERVICE:-} && -n ${KONSOLE_DBUS_SESSION:-} ]] || return 1
    command -v qdbus6 &>/dev/null || return 1
    qdbus6 "$KONSOLE_DBUS_SERVICE" "$KONSOLE_DBUS_SESSION" "$@" 2>/dev/null
}

# Save the current title to put back on exit. Re-applying the *format* does not
# work: after a setTitle, Konsole keeps that text until something overwrites it.
ORIG_TITLE="$(kon title 1)" || true
[[ -n ${ORIG_TITLE:-} ]] || ORIG_TITLE="$(basename "${SHELL:-bash}")"

set_title() {
    : 'Put a text on the tab title.

    D-Bus is used when there is a Konsole, and the OSC escape sequences cover the
    other terminals. The sequences are only emitted on a terminal, otherwise they
    would show up as garbage in a pipe or a file.

    Args:
        TITLE (str): Text to display.'

    kon setTitle 1 "$1" > /dev/null || true
    [[ -t 1 ]] && printf '\033]30;%s\007\033]0;%s\007' "$1" "$1"
}

restore_title() {
    : 'Put the original title back.'

    kon setTitle 1 "$ORIG_TITLE" > /dev/null || true
    [[ -t 1 ]] && printf '\033]30;%s\007\033]0;%s\007' "$ORIG_TITLE" "$ORIG_TITLE"
}

has_console() {
    : 'Tell whether a VM is wired for a serial console.

    The domain XML is read rather than "ttyconsole", which only answers for a
    running domain. This has to work for the stopped ones too, since those are
    listed as well.

    Args:
        VM_NAME (str): Name of the domain.

    Returns:
        0 when there is a console device, 1 otherwise.'

    virsh -c "$CONF" dumpxml "$1" 2> /dev/null | grep -q "<console type='pty'"
}

ip_of() {
    : 'Find the address of a VM, trying every source libvirt has.

    The DHCP leases alone are not enough: the table is emptied when the daemon
    restarts, while the guest carries on with the address it already holds, and a
    guest with a static address was never in it to begin with. The ARP table of
    the host knows those, and the guest agent -- where one is installed -- knows
    them best of all.

    Args:
        VM_NAME (str): Name of the domain.

    Returns:
        The IP, on the standard output. Empty when no source has one, which is
    the case for a stopped VM and for one that has not spoken on the network yet.'

    local SOURCE_NOW IP_VALUE

    for SOURCE_NOW in lease agent arp; do
        IP_VALUE="$(virsh -c "$CONF" domifaddr "$1" --source "$SOURCE_NOW" 2> /dev/null \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
        if [ -n "$IP_VALUE" ]; then
            printf '%s' "$IP_VALUE"
            return 0
        fi
    done

    return 0
}

state_of() {
    : 'Give the state of a single VM as a single word.

    Used on the machine that was picked, not while building the list -- that one
    gets every state in the same batch as everything else.

    Args:
        VM_NAME (str): Name of the domain.

    Returns:
        "running", "shutoff" or whatever else libvirt reports, on the standard
    output.'

    local STATE_VALUE
    STATE_VALUE="$(virsh -c "$CONF" domstate "$1" 2> /dev/null)"
    printf '%s' "${STATE_VALUE// /}"
}

survey_vms() {
    : 'Collect everything the list needs, in two calls to virsh.

    Asking per VM meant a connection per question -- four of them, times the
    number of machines. That is invisible on a local socket and painful over SSH,
    where every one of them is a fresh handshake and, without a key, a fresh
    password prompt. Two calls now, whatever the number of machines.

    Three things made it possible: "dumpxml" already carries the MAC, so
    "domiflist" was never needed; the DHCP leases are one table for everybody, not
    one lookup per VM; and virsh runs a whole script of commands over a single
    connection when it is fed through the standard input.

    Returns:
        One line per VM, on the standard output, as
    "NAME\037STATE\037IP\037HAS_CONSOLE", separated by unit separators rather
    than tabs: a tab is IFS whitespace to bash, so two in a row collapse into one
    and an empty IP silently shifts every field after it. Every VM is listed --
    SSH wants an address, not a console device.'

    local NAMES_VALUE BATCH_VALUE OUT_VALUE

    NAMES_VALUE="$(virsh -q -c "$CONF" list --all --name 2> /dev/null | grep '[^[:space:]]')"
    [ -n "$NAMES_VALUE" ] || return 0

    # One script, one connection. The markers are what tells whose answer is
    # whose on the way back, since virsh writes everything into a single stream.
    BATCH_VALUE="net-dhcp-leases default"$'\n'
    while IFS= read -r VM_NOW; do
        BATCH_VALUE+="echo VCONSEP${VM_NOW}VCONSEP"$'\n'
        BATCH_VALUE+="domstate ${VM_NOW}"$'\n'
        BATCH_VALUE+="echo VCONADDR"$'\n'
        BATCH_VALUE+="domifaddr ${VM_NOW} --source arp"$'\n'
        BATCH_VALUE+="echo VCONXML"$'\n'
        BATCH_VALUE+="dumpxml ${VM_NOW}"$'\n'
    done <<< "$NAMES_VALUE"

    OUT_VALUE="$(printf '%s' "$BATCH_VALUE" | virsh -q -c "$CONF" 2> /dev/null)"

    # NOTE: The prompts virsh writes ("virsh # ") are left where they are. Nothing
    # is parsed positionally here -- each line is recognised by what it holds --
    # so they are simply never matched by anything.
    printf '%s' "$OUT_VALUE" | awk '
        # The leases table comes first, before any marker: MAC -> IP.
        /^VCONSEP/ { seen_first = 1 }
        !seen_first && $0 ~ /([0-9a-f]{2}:){5}[0-9a-f]{2}/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/) mac_field = i
                if ($i ~ /^[0-9.]+\/[0-9]+$/) { split($i, a, "/"); ip_field = a[1] }
            }
            if (mac_field && ip_field) lease[$mac_field] = ip_field
            mac_field = 0; ip_field = ""
        }
        # From here on, a marker opens the answers of one machine.
        {
            if (match($0, /VCONSEP.*VCONSEP/)) {
                name = substr($0, RSTART + 7, RLENGTH - 14)
                section = "state"
                next
            }
            if ($0 ~ /VCONADDR/) { section = "addr"; next }
            if ($0 ~ /VCONXML/)  { section = "xml";  next }
        }
        name == "" { next }
        # "domstate" answers with one bare word, on its own line.
        section == "state" && $0 ~ /^(running|shut off|paused|idle|in shutdown|crashed|pmsuspended)$/ {
            state[name] = $0; gsub(/ /, "", state[name]); next
        }
        # "domifaddr --source arp" reads the ARP table of the host, which knows
        # machines the lease table has forgotten -- after the daemon restarted,
        # for instance, while the guest kept the address it already had.
        section == "addr" && match($0, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/) {
            if (!(name in arp)) arp[name] = substr($0, RSTART, RLENGTH)
        }
        section == "xml" && /<console type=.pty./ { console[name] = 1 }
        section == "xml" && /<mac address=/ {
            if (match($0, /([0-9a-f]{2}:){5}[0-9a-f]{2}/) && !(name in mac))
                mac[name] = substr($0, RSTART, RLENGTH)
        }
        # Every machine that answered "domstate" exists, console or not: SSH wants
        # an address, not a console device.
        END {
            for (n in state) {
                ip = (n in mac && mac[n] in lease) ? lease[mac[n]] : \
                     ((n in arp) ? arp[n] : "")
                printf "%s\037%s\037%s\037%s\n", n, state[n], ip,
                       (n in console ? 1 : 0)
            }
        }
    ' | LC_ALL=C sort
}

ensure_running() {
    : 'Start a VM if it is not running, and wait for its console to exist.

    Starting is not enough to connect: the pty comes up a moment later, and
    attaching before it does gets you an error instead of a console.

    Args:
        VM_NAME (str): Name of the domain.

    Returns:
        0 when there is a console to attach to, 1 otherwise.'

    local VM_NAME="$1"
    local WAITED_FOR=0

    if [[ "$(state_of "$VM_NAME")" == "running" ]]; then
        return 0
    fi

    echo "Starting $VM_NAME..."
    virsh -c "$CONF" start "$VM_NAME" > /dev/null || return 1

    while (( WAITED_FOR < START_TIMEOUT )); do
        [[ -n $(virsh -c "$CONF" ttyconsole "$VM_NAME" 2> /dev/null) ]] && return 0
        sleep 1
        (( WAITED_FOR++ ))
    done

    echo "Gave up waiting ${START_TIMEOUT}s for the console of $VM_NAME." >&2
    return 1
}

f_ssh_user_for() {
    : 'Work out which user to connect as, and ask when nothing says.

    Guessing is what this avoids. Falling back to the local user name is what ssh
    does on its own, and on a guest whose account is "root" that is simply the
    wrong answer given confidently -- so it is offered as a suggestion to accept,
    never applied behind your back.

    Args:
        VM_NAME (str): Name of the domain.
        IP_VALUE (str): Address it will connect to.

    Returns:
        The user name on the standard output, empty to let ssh decide by itself
    (which is what honours a "User" line in "~/.ssh/config").'

    local VM_NAME="$1"
    local IP_VALUE="$2"
    local HINT_VALUE=""
    local ANSWER_VALUE=""

    # Named for this machine: nothing to ask.
    if [ -n "${SSH_USERS[$VM_NAME]:-}" ]; then
        printf '%s' "${SSH_USERS[$VM_NAME]}"
        return 0
    fi

    # Named for all of them: nothing to ask either.
    if [ -n "$SSH_USER" ]; then
        printf '%s' "$SSH_USER"
        return 0
    fi

    # Nothing in the configuration, so ask. The hint is what ssh itself would use
    # for this host, "~/.ssh/config" included, so an empty answer keeps its normal
    # behaviour rather than overriding it.
    HINT_VALUE="$(ssh -G "$IP_VALUE" 2> /dev/null | awk '/^user /{print $2; exit}')"

    read -r -p "User for SSH on ${VM_NAME}${HINT_VALUE:+ [$HINT_VALUE]}: " \
        ANSWER_VALUE < /dev/tty

    printf '%s' "$ANSWER_VALUE"
}

f_wait_for_ip() {
    : 'Wait until a VM has an address, and give it back.

    A machine that was just started has no lease yet: it has to boot far enough to
    ask for one. Connecting before that fails with nothing useful to say, so this
    waits, and gives up with a status rather than an empty string.

    Args:
        VM_NAME (str): Name of the domain.

    Returns:
        The IP on the standard output, 0 when there is one. 1 when none turned up
    before IP_TIMEOUT.'

    local VM_NAME="$1"
    local WAITED_FOR=0
    local IP_VALUE=""

    while (( WAITED_FOR < IP_TIMEOUT )); do
        IP_VALUE="$(ip_of "$VM_NAME")"
        if [ -n "$IP_VALUE" ]; then
            printf '%s' "$IP_VALUE"
            return 0
        fi
        sleep 1
        (( WAITED_FOR++ ))
    done

    return 1
}

# --- Pick a VM ---------------------------------------------------------------

# SSH is the default because it is a terminal citizen: scrollback, resizing, your
# keys, scp, port forwarding, and Konsole naming the tab by itself. The serial
# console answers a different need -- it works with no network at all -- so it is
# there for when the network is what broke, behind a "t".
USE_TTY=0

vm=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--tty) USE_TTY=1 ;;
        -*) echo "Unknown option '$1'." >&2; exit 1 ;;
        *) vm="$1" ;;
    esac
    shift
done

if [[ -z $vm ]]; then
    vms=(); labels=(); consoles=()
    while IFS=$'\037' read -r n st ip hascon; do
        [[ -n $n ]] || continue
        vms+=("$n")
        consoles+=("$hascon")
        labels+=("$(printf '%-48s %-18s [%s]' "$n" "$ip" "$st")")
    done < <(survey_vms)

    if (( ${#vms[@]} == 0 )); then
        echo "No VM found."
        exit 1
    fi

    echo "VMs:"
    for i in "${!vms[@]}"; do
        printf "  %2d) %s\n" $((i+1)) "${labels[$i]}"
    done
    read -rp "Number to (run and) connect by SSH, t+number for serial console, or 0/quit: " n

    # Leaving without picking anything is a normal way out, not a mistake.
    case "$n" in
        0|quit) exit 0 ;;
    esac

    # "t" in front asks for the serial console instead of SSH.
    if [[ $n == t* || $n == T* ]]; then
        USE_TTY=1
        n="${n:1}"
    fi

    [[ $n =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#vms[@]} )) || { echo "Invalid choice."; exit 1; }
    vm="${vms[$((n-1))]}"
else
    virsh -c "$CONF" domstate "$vm" &>/dev/null || { echo "VM '$vm' does not exist."; exit 1; }
fi

# --- Connect -----------------------------------------------------------------

if [ ${USE_TTY} -eq 1 ]; then
    has_console "$vm" || {
        echo "VM '$vm' has no serial console in its domain XML, so there is"\
" nothing to attach to." >&2
        echo "Add one with \"virsh edit\", or connect by SSH instead." >&2
        exit 1
    }

    ensure_running "$vm" || exit 1

    ip=$(ip_of "$vm")
    trap restore_title EXIT INT TERM
    set_title "(console) ${vm}${ip:+ $ip}"
    echo "Connecting to $vm${ip:+ ($ip)} by serial console -- exit with Ctrl + ]"
    virsh -c "$CONF" console "$vm" --force
    exit $?
fi

# --- SSH ---
command -v ssh > /dev/null 2>&1 || {
    echo "\"ssh\" was not found. Install an SSH client, or use the serial console"\
" with \"t\" in front of the number." >&2
    exit 1
}

ensure_running "$vm" || exit 1

ip="$(f_wait_for_ip "$vm")" || {
    echo "No address for $vm: the guest may still be booting, may have no network,"\
" or may be on a network without the DHCP of libvirt." >&2
    echo "The serial console needs none of that -- put a \"t\" in front of the"\
" number, or use \"-t\"." >&2
    exit 1
}

ssh_user="$(f_ssh_user_for "$vm" "$ip")"

SSH_CMD=(ssh)
[ -n "${SSH_PORT:-}" ] && SSH_CMD+=(-p "$SSH_PORT")
SSH_CMD+=(${SSH_OPTS[@]+"${SSH_OPTS[@]}"})
SSH_CMD+=("${ssh_user:+$ssh_user@}$ip")

trap restore_title EXIT INT TERM
set_title "(ssh) ${vm} ${ip}"
echo "Connecting to $vm (${ssh_user:+$ssh_user@}$ip) by SSH..."
"${SSH_CMD[@]}"

